# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE - VSCode
.vscode/*

# dependencies
/node_modules
/.pnp
.pnp.js

# testing & coverage
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files (preserve template)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# compiled binaries & runtime local vault data
*.apk
!public/vectorgallery.apk
public/vectormind.apk
/data/*.json
!/data/.gitkeep

# local uploads
/public/uploads/*
!/public/uploads/.gitkeep
